  "options": {
    "reduceOptions": {
      "values": false,
      "calcs": [
        "lastNotNull"
      ],
      "fields": ""
    },
    "orientation": "auto",
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto"
  },
  "targets": [
    {
      "refId": "A",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
      },
      "editorMode": "code",
      "expr": "mina_payout_epoch{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)",
      "instant": true,
      "range": false,
      "format": "time_series",
      "legendFormat": "Epoch"
    },
    {
      "refId": "B",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
      },
      "editorMode": "code",
      "expr": "max without(status) ((mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"IDLE\"} * 0) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"WAITING_FOR_FUNDING\"} * 1) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"FUNDED_READY_FOR_EXECUTION\"} * 2) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"SIGNED_ATTEMPT_STARTED\"} * 3) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"SUBMITTED_WAITING_CONFIRMATION\"} * 4) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"COMPLETED_OK\"} * 5) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"BLOCKED_PENDING_TRANSACTION\"} * 6) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"BLOCKED_BALANCE_ABOVE_TARGET\"} * 7) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"BLOCKED_GPG_LOCKED\"} * 8) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"MANUAL_INTERVENTION_REQUIRED\"} * 9) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"HASH_MISMATCH\"} * 10) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"SIGNED_ATTEMPT_UNKNOWN\"} * 11) or (mina_payout_status{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\",status=\"TEST_DISCARDED\"} * 12)) and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)",
      "instant": true,
      "range": false,
      "format": "time_series",
      "legendFormat": "Status"
    },
    {
      "refId": "C",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
      },
      "editorMode": "code",
      "expr": "mina_payout_progress_percent{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)",
      "instant": true,
      "range": false,
      "format": "time_series",
      "legendFormat": "Confirmed progress"
    },
    {
      "refId": "D",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
      },
      "editorMode": "code",
      "expr": "mina_payout_transactions_confirmed{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)",
      "instant": true,
