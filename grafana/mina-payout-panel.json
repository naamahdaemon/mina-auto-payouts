      },
      "editorMode": "code",
      "expr": "(mina_payout_last_completed_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)) * 1000",
      "instant": true,
      "range": false,
      "format": "time_series",
      "legendFormat": "Last completion"
    },
    {
      "refId": "N",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
      },
      "editorMode": "code",
      "expr": "mina_payout_metrics_collection_success{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"REPLACE_JOB\",instance=\"REPLACE_INSTANCE\"} < 180)",
      "instant": true,
      "range": false,
      "format": "time_series",
      "legendFormat": "Collection health"
    },
    {
      "refId": "O",
      "datasource": {
        "type": "prometheus",
        "uid": "REPLACE_PROMETHEUS_UID"
