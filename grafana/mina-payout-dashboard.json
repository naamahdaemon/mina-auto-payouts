              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Idle",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "Waiting For Funding",
                        "color": "blue",
                        "index": 1
                      },
                      "2": {
                        "text": "Funded Ready For Execution",
                        "color": "blue",
                        "index": 2
                      },
                      "3": {
                        "text": "Signed Attempt Started",
                        "color": "blue",
                        "index": 3
                      },
                      "4": {
                        "text": "Submitted Waiting Confirmation",
                        "color": "blue",
                        "index": 4
                      },
                      "5": {
                        "text": "Completed Ok",
                        "color": "green",
                        "index": 5
                      },
                      "6": {
                        "text": "Blocked Pending Transaction",
                        "color": "orange",
                        "index": 6
                      },
                      "7": {
                        "text": "Blocked Balance Above Target",
                        "color": "red",
                        "index": 7
                      },
                      "8": {
                        "text": "Blocked Gpg Locked",
                        "color": "orange",
                        "index": 8
                      },
                      "9": {
                        "text": "Manual Intervention Required",
                        "color": "red",
                        "index": 9
                      },
                      "10": {
                        "text": "Hash Mismatch",
                        "color": "red",
                        "index": 10
                      },
                      "11": {
                        "text": "Signed Attempt Unknown",
                        "color": "red",
                        "index": 11
                      },
                      "12": {
                        "text": "Test Discarded",
                        "color": "orange",
                        "index": 12
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Confirmed progress"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 100
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Confirmed transactions"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
