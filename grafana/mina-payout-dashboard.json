      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_epoch{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Epoch"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max without(status) ((mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"IDLE\"} * 0) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"WAITING_FOR_FUNDING\"} * 1) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"FUNDED_READY_FOR_EXECUTION\"} * 2) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"SIGNED_ATTEMPT_STARTED\"} * 3) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"SUBMITTED_WAITING_CONFIRMATION\"} * 4) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"COMPLETED_OK\"} * 5) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"BLOCKED_PENDING_TRANSACTION\"} * 6) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"BLOCKED_BALANCE_ABOVE_TARGET\"} * 7) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"BLOCKED_GPG_LOCKED\"} * 8) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"MANUAL_INTERVENTION_REQUIRED\"} * 9) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"HASH_MISMATCH\"} * 10) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"SIGNED_ATTEMPT_UNKNOWN\"} * 11) or (mina_payout_status{job=\"$job\",instance=\"$instance\",status=\"TEST_DISCARDED\"} * 12)) and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Status"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_progress_percent{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Confirmed progress"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_transactions_confirmed{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Confirmed transactions"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_transactions_total{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Planned transactions"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_next_transaction_position{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Next awaiting confirmation"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_wallet_nonce{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Wallet nonce"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_wallet_inferred_nonce{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Inferred nonce"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_wallet_pending_transactions{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Pending transactions"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_wallet_balance_mina{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Wallet balance"
        },
        {
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_funding_remaining_mina{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Funding remaining"
        },
        {
          "refId": "L",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_last_completed_epoch{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Last completed epoch"
        },
        {
          "refId": "M",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(mina_payout_last_completed_timestamp_seconds{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)) * 1000",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Last completion"
        },
        {
          "refId": "N",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mina_payout_metrics_collection_success{job=\"$job\",instance=\"$instance\"} and on(job, instance) (time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"} < 180)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Collection health"
        },
        {
          "refId": "O",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "time() - mina_payout_metrics_collection_timestamp_seconds{job=\"$job\",instance=\"$instance\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Collection age"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
